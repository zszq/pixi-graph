{
  "name": "pixi-graph",
  "version": "2.0.0",
  "description": "Graph visualization library using PIXI.js and Graphology",
  "type": "module",
  "keywords": [
    "pixi",
    "graph",
    "graphology",
    "visualization"
  ],
  "license": "MIT",
  "author": "Jan Zak <zj@zakjan.cz>",
  "repository": "github:zakjan/pixi-graph",
  "main": "./dist/pixi-graph.js",
  "module": "./dist/pixi-graph.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pixi-graph.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:umd": "vite build --config vite.config.umd.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "graphology": "^0.25.0",
    "graphology-types": "^0.24.0"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@types/color-rgba": "^2.1.2",
    "color-rgba": "^3.0.0",
    "@types/node": "^22.19.19",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "graphology": "^0.25.4",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.7",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.2.4"
  }
}
